# Random secret. Give the same value to Nestify when installing the plugin.
PLUGIN_TOKEN=

# "name=value; name=value" from a browser request that went through THIS server's IP.
REZKA_COOKIES=

# Optional. Database with the rezka_map table, see README. Without it, titles are found by name.
REZKA_MAP_DATABASE_URL=

REZKA_ORIGIN=https://rezka.ag
# The name of the SSH key in the instructions on the extensions page.
REZKA_SSH_KEY_NAME=dota_server_ed25519
# Premium-only qualities, which are a one-minute stub otherwise. Leave empty for a premium account.
REZKA_HIDDEN_QUALITIES=1080p Ultra,2K,4K
# Must match the browser the cookies came from.
REZKA_USER_AGENT=
